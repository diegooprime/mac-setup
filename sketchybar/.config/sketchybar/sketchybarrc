#!/usr/bin/env bash
source "$HOME/.config/palette/colors.sh"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# ========================
# BAR
# ========================
sketchybar --bar \
  height=32 \
  color=0xff121214 \
  border_color=0x00000000 \
  border_width=0 \
  corner_radius=0 \
  y_offset=0 \
  margin=0 \
  position=top \
  sticky=on \
  topmost=window \
  padding_left=10 \
  padding_right=10 \
  blur_radius=0 \
  shadow=off

# ========================
# DEFAULTS
# ========================
sketchybar --default \
  icon.color="$CF_SKB_MUTED" \
  icon.font="JetBrainsMono Nerd Font:Bold:11.0" \
  icon.padding_left=6 \
  icon.padding_right=4 \
  label.color="$CF_SKB_WHITE" \
  label.font="JetBrainsMono Nerd Font:Regular:13.0" \
  label.padding_left=2 \
  label.padding_right=8 \
  background.drawing=off \
  padding_left=2 \
  padding_right=2

# ========================
# LEFT
# ========================
sketchybar --add item bluetooth left \
  --set bluetooth \
    icon="󰋋" \
    icon.font="JetBrainsMono Nerd Font:Regular:16.0" \
    icon.color="$CF_SKB_MUTED" \
    label.drawing=off \
    drawing=off \
    update_freq=5 \
    script="$PLUGIN_DIR/bluetooth.sh" \
  --subscribe bluetooth volume_change system_woke

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.color="$CF_SKB_WHITE" \
    label.font="JetBrainsMono Nerd Font:Bold:14.0" \
    label.padding_left=8 \
    label.padding_right=14 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item music left \
  --set music \
    icon.drawing=off \
    label.color="$CF_SKB_MUTED" \
    label.font="JetBrainsMono Nerd Font:Regular:12.0" \
    label.max_chars=34 \
    update_freq=10 \
    script="$PLUGIN_DIR/music.sh"

# ========================
# RIGHT
# ========================
sketchybar --add item clock right \
  --set clock \
    icon.drawing=off \
    label.color="$CF_SKB_WHITE" \
    label.font="JetBrainsMono Nerd Font:Bold:14.0" \
    label.padding_right=10 \
    update_freq=30 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item date right \
  --set date \
    icon.drawing=off \
    label.color="$CF_SKB_TEXT" \
    update_freq=60 \
    script="$PLUGIN_DIR/date.sh"

sketchybar --add item battery right \
  --set battery \
    icon.drawing=off \
    label.color="$CF_SKB_TEXT" \
    update_freq=30 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

sketchybar --add item ram right \
  --set ram \
    icon="MEM" \
    update_freq=5 \
    script="$PLUGIN_DIR/ram.sh"

sketchybar --add item cpu right \
  --set cpu \
    icon="CPU" \
    update_freq=5 \
    script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item network right \
  --set network \
    icon="NET" \
    update_freq=2 \
    script="$PLUGIN_DIR/network.sh"

# ========================
# INIT
# ========================
sketchybar --update
